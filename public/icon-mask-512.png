<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512">
  <defs>
    <linearGradient id="bgMask" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10b981;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#059669;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#047857;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="cloudMask" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffffff;stop-opacity:0.95" />
      <stop offset="100%" style="stop-color:#f3f4f6;stop-opacity:0.9" />
    </linearGradient>
    <radialGradient id="sunMask" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0%" style="stop-color:#FCD34D" />
      <stop offset="70%" style="stop-color:#F59E0B" />
      <stop offset="100%" style="stop-color:#D97706" />
    </radialGradient>
    <linearGradient id="raindropMask" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3B82F6" />
      <stop offset="50%" style="stop-color:#2563EB" />
      <stop offset="100%" style="stop-color:#1D4ED8" />
    </linearGradient>
    <filter id="dropShadowMask" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="3" dy="4" stdDeviation="3" floodColor="#000000" floodOpacity="0.15"/>
    </filter>
    <!-- Safe area circle mask (409x409 centered) -->
    <mask id="safeAreaMask">
      <rect width="512" height="512" fill="black"/>
      <circle cx="256" cy="256" r="204.5" fill="white"/>
    </mask>
  </defs>
  
  <!-- Background with safe area -->
  <rect width="512" height="512" fill="url(#bgMask)" mask="url(#safeAreaMask)"/>
  
  <!-- Content within safe area -->
  <g mask="url(#safeAreaMask)">
    <!-- Sun rays (behind cloud) -->
    <g opacity="0.7">
      <path d="M340 140 L360 120 M360 160 L380 160 M340 180 L360 200" stroke="#F59E0B" strokeWidth="6" strokeLinecap="round" />
      <path d="M320 120 L320 100 M380 140 L400 135" stroke="#F59E0B" strokeWidth="6" strokeLinecap="round" />
    </g>
    
    <!-- Sun (behind cloud) -->
    <circle 
      cx="340" 
      cy="160" 
      r="35" 
      fill="url(#sunMask)"
      filter="url(#dropShadowMask)"
      opacity="0.9"
    />
    
    <!-- Main Cloud Shape -->
    <path
      d="M150 256 C150 235, 167 218, 190 218 C195 195, 220 176, 256 176 C292 176, 317 195, 322 218 C345 218, 362 235, 362 256 C362 277, 345 294, 322 294 L190 294 C167 294, 150 277, 150 256 Z"
      fill="url(#cloudMask)"
      stroke="#e5e7eb"
      strokeWidth="3"
      filter="url(#dropShadowMask)"
    />
    
    <!-- Cloud Highlight -->
    <ellipse
      cx="256"
      cy="240"
      rx="60"
      ry="30"
      fill="#FFFFFF"
      opacity="0.4"
    />
    
    <!-- Raindrops -->
    <g opacity="0.9">
      <!-- Large Raindrops -->
      <ellipse cx="210" cy="330" rx="8" ry="20" fill="url(#raindropMask)" />
      <ellipse cx="256" cy="340" rx="8" ry="20" fill="url(#raindropMask)" />
      <ellipse cx="302" cy="330" rx="8" ry="20" fill="url(#raindropMask)" />
      
      <!-- Medium Raindrops -->
      <ellipse cx="233" cy="370" rx="6" ry="15" fill="url(#raindropMask)" opacity="0.8" />
      <ellipse cx="279" cy="380" rx="6" ry="15" fill="url(#raindropMask)" opacity="0.8" />
      
      <!-- Small Raindrops -->
      <ellipse cx="190" cy="380" rx="4" ry="10" fill="url(#raindropMask)" opacity="0.6" />
      <ellipse cx="322" cy="370" rx="4" ry="10" fill="url(#raindropMask)" opacity="0.6" />
      <ellipse cx="245" cy="410" rx="4" ry="10" fill="url(#raindropMask)" opacity="0.6" />
      <ellipse cx="267" cy="420" rx="4" ry="10" fill="url(#raindropMask)" opacity="0.6" />
    </g>
    
    <!-- Subtle Cascade Effect Lines -->
    <g opacity="0.3" stroke="#3B82F6" strokeWidth="3" strokeLinecap="round">
      <path d="M215 320 Q225 350 235 380" />
      <path d="M261 330 Q271 360 281 390" />
      <path d="M307 320 Q317 350 327 380" />
    </g>
  </g>
</svg>