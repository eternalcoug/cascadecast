<svg xmlns="http://www.w3.org/2000/svg" width="192" height="192" viewBox="0 0 192 192">
  <defs>
    <linearGradient id="bg192" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10b981;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#059669;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#047857;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="cloud192" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffffff;stop-opacity:0.95" />
      <stop offset="100%" style="stop-color:#f3f4f6;stop-opacity:0.9" />
    </linearGradient>
    <radialGradient id="sun192" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0%" style="stop-color:#FCD34D" />
      <stop offset="70%" style="stop-color:#F59E0B" />
      <stop offset="100%" style="stop-color:#D97706" />
    </radialGradient>
    <linearGradient id="raindrop192" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3B82F6" />
      <stop offset="50%" style="stop-color:#2563EB" />
      <stop offset="100%" style="stop-color:#1D4ED8" />
    </linearGradient>
    <filter id="dropShadow192" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="2" dy="3" stdDeviation="2" floodColor="#000000" floodOpacity="0.2"/>
    </filter>
  </defs>
  
  <!-- Background -->
  <rect width="192" height="192" rx="24" fill="url(#bg192)"/>
  
  <!-- Sun rays (behind cloud) -->
  <g opacity="0.8">
    <path d="M134 48 L144 38 M144 58 L154 58 M134 67 L144 77" stroke="#F59E0B" strokeWidth="4" strokeLinecap="round" />
    <path d="M125 38 L125 28 M154 48 L164 43" stroke="#F59E0B" strokeWidth="4" strokeLinecap="round" />
  </g>
  
  <!-- Sun (behind cloud) -->
  <circle 
    cx="134" 
    cy="67" 
    r="20" 
    fill="url(#sun192)"
    filter="url(#dropShadow192)"
    opacity="0.9"
  />
  
  <!-- Main Cloud Shape -->
  <path
    d="M48 96 C48 84, 57 75, 69 75 C72 63, 84 54, 99 54 C114 54, 126 63, 129 75 C141 75, 150 84, 150 96 C150 108, 141 117, 129 117 L69 117 C57 117, 48 108, 48 96 Z"
    fill="url(#cloud192)"
    stroke="#e5e7eb"
    strokeWidth="2"
    filter="url(#dropShadow192)"
  />
  
  <!-- Cloud Highlight -->
  <ellipse
    cx="99"
    cy="84"
    rx="32"
    ry="16"
    fill="#FFFFFF"
    opacity="0.4"
  />
  
  <!-- Raindrops -->
  <g opacity="0.9">
    <!-- Large Raindrops -->
    <ellipse cx="72" cy="138" rx="4" ry="10" fill="url(#raindrop192)" />
    <ellipse cx="99" cy="144" rx="4" ry="10" fill="url(#raindrop192)" />
    <ellipse cx="126" cy="138" rx="4" ry="10" fill="url(#raindrop192)" />
    
    <!-- Medium Raindrops -->
    <ellipse cx="84" cy="156" rx="3" ry="7" fill="url(#raindrop192)" opacity="0.8" />
    <ellipse cx="111" cy="162" rx="3" ry="7" fill="url(#raindrop192)" opacity="0.8" />
    
    <!-- Small Raindrops -->
    <ellipse cx="63" cy="162" rx="2.5" ry="5" fill="url(#raindrop192)" opacity="0.6" />
    <ellipse cx="135" cy="156" rx="2.5" ry="5" fill="url(#raindrop192)" opacity="0.6" />
    <ellipse cx="90" cy="174" rx="2.5" ry="5" fill="url(#raindrop192)" opacity="0.6" />
    <ellipse cx="117" cy="180" rx="2.5" ry="5" fill="url(#raindrop192)" opacity="0.6" />
  </g>
  
  <!-- Subtle Cascade Effect Lines -->
  <g opacity="0.3" stroke="#3B82F6" strokeWidth="1.5" strokeLinecap="round">
    <path d="M75 132 Q81 150 87 168" />
    <path d="M102 138 Q108 156 114 174" />
    <path d="M129 132 Q135 150 141 168" />
  </g>
</svg>