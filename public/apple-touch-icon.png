<svg xmlns="http://www.w3.org/2000/svg" width="180" height="180" viewBox="0 0 180 180">
  <defs>
    <linearGradient id="bgApple" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10b981;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#059669;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#047857;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="cloudApple" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffffff;stop-opacity:0.95" />
      <stop offset="100%" style="stop-color:#f3f4f6;stop-opacity:0.9" />
    </linearGradient>
    <radialGradient id="sunApple" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0%" style="stop-color:#FCD34D" />
      <stop offset="70%" style="stop-color:#F59E0B" />
      <stop offset="100%" style="stop-color:#D97706" />
    </radialGradient>
    <linearGradient id="raindropApple" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3B82F6" />
      <stop offset="50%" style="stop-color:#2563EB" />
      <stop offset="100%" style="stop-color:#1D4ED8" />
    </linearGradient>
    <filter id="dropShadowApple" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="2" dy="3" stdDeviation="2" floodColor="#000000" floodOpacity="0.2"/>
    </filter>
  </defs>
  
  <!-- Background with 20px padding -->
  <rect width="180" height="180" rx="20" fill="url(#bgApple)"/>
  
  <!-- Sun rays (behind cloud) -->
  <g opacity="0.8">
    <path d="M126 36 L132 24" stroke="#F59E0B" strokeWidth="3" strokeLinecap="round" />
    <path d="M144 42 L156 36" stroke="#F59E0B" strokeWidth="3" strokeLinecap="round" />
    <path d="M153 63 L165 63" stroke="#F59E0B" strokeWidth="3" strokeLinecap="round" />
    <path d="M144 84 L156 90" stroke="#F59E0B" strokeWidth="3" strokeLinecap="round" />
    <path d="M108 42 L96 36" stroke="#F59E0B" strokeWidth="3" strokeLinecap="round" />
    <path d="M99 63 L87 63" stroke="#F59E0B" strokeWidth="3" strokeLinecap="round" />
  </g>
  
  <!-- Sun (behind cloud) -->
  <circle 
    cx="126" 
    cy="63" 
    r="18" 
    fill="url(#sunApple)"
    filter="url(#dropShadowApple)"
    opacity="0.9"
  />
  
  <!-- Main Cloud Shape -->
  <path
    d="M45 90 C45 78, 54 69, 66 69 C69 57, 81 48, 96 48 C111 48, 123 57, 126 69 C138 69, 147 78, 147 90 C147 102, 138 111, 126 111 L66 111 C54 111, 45 102, 45 90 Z"
    fill="url(#cloudApple)"
    stroke="#e5e7eb"
    strokeWidth="1"
    filter="url(#dropShadowApple)"
  />
  
  <!-- Cloud Highlight -->
  <ellipse
    cx="96"
    cy="78"
    rx="30"
    ry="15"
    fill="#FFFFFF"
    opacity="0.4"
  />
  
  <!-- Raindrops -->
  <g opacity="0.9">
    <!-- Large Raindrops -->
    <ellipse cx="69" cy="129" rx="4" ry="9" fill="url(#raindropApple)" />
    <ellipse cx="96" cy="135" rx="4" ry="9" fill="url(#raindropApple)" />
    <ellipse cx="123" cy="129" rx="4" ry="9" fill="url(#raindropApple)" />
    
    <!-- Medium Raindrops -->
    <ellipse cx="81" cy="147" rx="3" ry="6" fill="url(#raindropApple)" opacity="0.8" />
    <ellipse cx="108" cy="153" rx="3" ry="6" fill="url(#raindropApple)" opacity="0.8" />
    
    <!-- Small Raindrops -->
    <ellipse cx="60" cy="153" rx="2" ry="4" fill="url(#raindropApple)" opacity="0.6" />
    <ellipse cx="132" cy="147" rx="2" ry="4" fill="url(#raindropApple)" opacity="0.6" />
    <ellipse cx="87" cy="165" rx="2" ry="4" fill="url(#raindropApple)" opacity="0.6" />
    <ellipse cx="114" cy="171" rx="2" ry="4" fill="url(#raindropApple)" opacity="0.6" />
  </g>
  
  <!-- Subtle Cascade Effect Lines -->
  <g opacity="0.3" stroke="#3B82F6" strokeWidth="1.5" strokeLinecap="round">
    <path d="M72 123 Q78 141 84 159" />
    <path d="M99 129 Q105 147 111 165" />
    <path d="M126 123 Q132 141 138 159" />
  </g>
</svg>