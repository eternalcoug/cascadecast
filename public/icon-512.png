<svg xmlns="http://www.w3.org/2000/svg" width="512" height="512" viewBox="0 0 512 512">
  <defs>
    <linearGradient id="bg512" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#10b981;stop-opacity:1" />
      <stop offset="50%" style="stop-color:#059669;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#047857;stop-opacity:1" />
    </linearGradient>
    <linearGradient id="cloud512" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ffffff;stop-opacity:0.95" />
      <stop offset="100%" style="stop-color:#f3f4f6;stop-opacity:0.9" />
    </linearGradient>
    <radialGradient id="sun512" cx="0.5" cy="0.5" r="0.5">
      <stop offset="0%" style="stop-color:#FCD34D" />
      <stop offset="70%" style="stop-color:#F59E0B" />
      <stop offset="100%" style="stop-color:#D97706" />
    </radialGradient>
    <linearGradient id="raindrop512" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#3B82F6" />
      <stop offset="50%" style="stop-color:#2563EB" />
      <stop offset="100%" style="stop-color:#1D4ED8" />
    </linearGradient>
    <filter id="dropShadow512" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="4" dy="6" stdDeviation="4" floodColor="#000000" floodOpacity="0.2"/>
    </filter>
  </defs>
  
  <!-- Background -->
  <rect width="512" height="512" rx="64" fill="url(#bg512)"/>
  
  <!-- Sun rays (behind cloud) -->
  <g opacity="0.8">
    <path d="M358 128 L384 102 M384 154 L410 154 M358 179 L384 205" stroke="#F59E0B" strokeWidth="8" strokeLinecap="round" />
    <path d="M333 102 L333 76 M410 128 L436 118" stroke="#F59E0B" strokeWidth="8" strokeLinecap="round" />
    <path d="M384 76 L394 66 M436 154 L446 144" stroke="#F59E0B" strokeWidth="6" strokeLinecap="round" opacity="0.5" />
  </g>
  
  <!-- Sun (behind cloud) -->
  <circle 
    cx="358" 
    cy="179" 
    r="50" 
    fill="url(#sun512)"
    filter="url(#dropShadow512)"
    opacity="0.9"
  />
  
  <!-- Main Cloud Shape -->
  <path
    d="M128 256 C128 230, 149 209, 179 209 C186 179, 218 154, 256 154 C294 154, 326 179, 333 209 C363 209, 384 230, 384 256 C384 282, 363 303, 333 303 L179 303 C149 303, 128 282, 128 256 Z"
    fill="url(#cloud512)"
    stroke="#e5e7eb"
    strokeWidth="4"
    filter="url(#dropShadow512)"
  />
  
  <!-- Cloud Highlight -->
  <ellipse
    cx="256"
    cy="230"
    rx="80"
    ry="40"
    fill="#FFFFFF"
    opacity="0.4"
  />
  
  <!-- Raindrops -->
  <g opacity="0.9">
    <!-- Large Raindrops -->
    <ellipse cx="192" cy="358" rx="10" ry="25" fill="url(#raindrop512)" />
    <ellipse cx="256" cy="371" rx="10" ry="25" fill="url(#raindrop512)" />
    <ellipse cx="320" cy="358" rx="10" ry="25" fill="url(#raindrop512)" />
    
    <!-- Medium Raindrops -->
    <ellipse cx="224" cy="410" rx="8" ry="20" fill="url(#raindrop512)" opacity="0.8" />
    <ellipse cx="288" cy="423" rx="8" ry="20" fill="url(#raindrop512)" opacity="0.8" />
    
    <!-- Small Raindrops -->
    <ellipse cx="166" cy="423" rx="6" ry="15" fill="url(#raindrop512)" opacity="0.6" />
    <ellipse cx="346" cy="410" rx="6" ry="15" fill="url(#raindrop512)" opacity="0.6" />
    <ellipse cx="230" cy="461" rx="6" ry="15" fill="url(#raindrop512)" opacity="0.6" />
    <ellipse cx="282" cy="474" rx="6" ry="15" fill="url(#raindrop512)" opacity="0.6" />
  </g>
  
  <!-- Subtle Cascade Effect Lines -->
  <g opacity="0.3" stroke="#3B82F6" strokeWidth="4" strokeLinecap="round">
    <path d="M198 346 Q210 384 222 422" />
    <path d="M262 359 Q274 397 286 435" />
    <path d="M326 346 Q338 384 350 422" />
  </g>
</svg>